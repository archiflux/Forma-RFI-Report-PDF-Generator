# Copy to .env.local and fill in. .env.local is git-ignored.
#
# This is a PUBLIC client id — safe to expose in the browser because the app
# uses OAuth 3LO with PKCE (no client secret). Still, every dev / environment
# should use its own APS app so callback URLs line up cleanly.
#
# Create one at https://aps.autodesk.com/myapps — enable Authentication,
# Data Management API, and Autodesk Construction Cloud API.
NEXT_PUBLIC_APS_CLIENT_ID=

# Scopes requested at sign-in. The app is read-only at the REQUEST layer
# (verb allow-list in ApsClient + the /api/aps proxy + a CI test). The
# token includes data:write + data:create because APS requires them to GET
# the custom-attribute schema endpoint that supplies friendly field names.
# Never add *:delete / *:destroy.
NEXT_PUBLIC_APS_SCOPES="data:read data:write data:create account:read viewables:read user-profile:read"

# OAuth redirect URI. Must match exactly what's configured on the APS app.
NEXT_PUBLIC_APS_REDIRECT_URI="http://localhost:3000/auth/callback"
